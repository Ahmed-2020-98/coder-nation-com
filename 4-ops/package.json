{
  "name": "4-ops",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 3020",
    "build": "node scripts/gen-migrations.mjs && next build",
    "start": "next start -p 3020",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "gen:migrations": "node scripts/gen-migrations.mjs",
    "db:migrate": "node scripts/migrate.mjs",
    "user:create": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/create-user.mjs",
    "test": "vitest run",
    "build:webpack": "node scripts/gen-migrations.mjs && TAILWIND_POSTCSS=1 next build --webpack"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "2.3.1",
    "lucide-react": "^1.63.0",
    "mcp-handler": "2.3.0",
    "mysql2": "^3.24.6",
    "next": "16.4.3",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "^0.0.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^24.19.2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.3",
    "postcss": "^8.5.32",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^5.0.5"
  }
}
