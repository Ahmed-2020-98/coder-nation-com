# Copy this file to .env.local and fill it in. .env.local is git-ignored and is read by the SERVER only:
# nothing here is ever exposed to the browser (no NEXT_PUBLIC_ variables are used).

# How the agents sign in. You need ONE of these two; nothing here is required to open the pages.
#
# 1) No key (default): the Agent SDK uses the claude.ai login that `claude` already has on this machine.
#    Check with `claude auth status`; sign in with `claude` then `/login`. Runs count against your plan's usage
#    limits. PERSONAL, LOCAL use by the account owner only: don't share this login with the team or deploy it
#    (Anthropic's Agent SDK page restricts third parties from offering claude.ai login in their products).
#
# 2) An API key (billed per token; use this for the team or for marketing.codernation.com later).
#    Create one at https://console.anthropic.com/settings/keys
# ANTHROPIC_API_KEY=
#
# auto (default: a key in the environment wins, otherwise the subscription login) | subscription | api_key.
# "subscription" also hides any exported ANTHROPIC_API_KEY from the agents so it can never be billed by accident.
# CLAUDE_AUTH=auto

# The Marketing Agent project (CLAUDE.md, .claude/agents, marketing/). Relative paths resolve from this folder.
AGENT_ROOT=../2-marketing-agent

# Model alias or full model id used by every run (sonnet | opus | haiku | a full id).
CLAUDE_MODEL=sonnet

# Optional reasoning effort for every run: low | medium | high | xhigh | max (unset = the model's default).
# More effort means more thinking, which means more usage (or money). Not tuned yet: measure before lowering.
# RUN_EFFORT=medium

# Per-run cap in USD. The run stops with a clear error when it is reached. With an API key this is real money; with
# the subscription login it is only the SDK's own estimate of the run's size. (A guess: tune it.)
RUN_BUDGET_USD=2

# Footage upload limit in MB.
MAX_UPLOAD_MB=2048

# How many runs may be active at once. Default: 1 with the subscription login (shared usage limits), 2 with a key.
# MAX_CONCURRENT_RUNS=1

# Optional: where the SQLite file and uploaded footage live (default: ./data).
# DATA_DIR=data

# DEV ONLY. 1 = simulate the agents (no API calls, no cost) so the UI can be explored. Ignored in production.
# FAKE_AGENT_RUNS=1
