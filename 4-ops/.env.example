# Copy to .env.local and fill in. .env.local is git-ignored (every .env* file is, except this one).
# Read by the SERVER only; nothing here is ever exposed to the browser.

# Postgres for the team's accounts, the CRM and the proposals.
#   createdb coder_nation_ops && npm run db:migrate
DATABASE_URL=postgres://localhost:5432/coder_nation_ops

# Secret used to hash IP addresses for rate limiting (so raw IPs are never stored). 16+ random characters.
# REQUIRED in production, e.g.: openssl rand -hex 24
IP_HASH_SALT=

# Shared secret with the public website (1-coder-nation): it signs every lead it forwards with this.
# Set the same value as OPS_INTAKE_SECRET there. 32+ random characters, e.g.: openssl rand -hex 32
INTAKE_SECRET=

# Where Chrome (headless) loads the proposal print page to make the PDF. Default: this app on its own port.
# APP_URL=http://127.0.0.1:3020

# Chrome / Chromium used for PDFs. Default: the standard macOS Chrome path, then `google-chrome` on Linux.
# CHROME_PATH=/Applications/Google Chrome.app/Contents/MacOS/Google Chrome
