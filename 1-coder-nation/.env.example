# Copy to .env.local and fill in. .env.local is git-ignored (every .env* file is, except this one).
# Everything here is read by the SERVER only; nothing is ever exposed to the browser.

# Postgres for the contact-form leads, the site settings and the admin accounts.
# Create it once, then run `npm run db:migrate`:
#   createdb coder_nation_site
DATABASE_URL=postgres://localhost:5432/coder_nation_site

# Public origin of the site (canonical URLs, sitemap, Open Graph). No trailing path.
SITE_URL=http://localhost:3000

# Secret used to hash visitors' IP addresses (so the raw IP is never stored). 16+ random characters.
# REQUIRED in production, e.g.: openssl rand -hex 24
IP_HASH_SALT=

# Optional: forward every new lead to the internal CRM (4-ops). Both must be set, and the secret must equal INTAKE_SECRET
# there (32+ random characters, e.g. `openssl rand -hex 32`). Leave empty to keep leads only in this site's /admin.
# OPS_INTAKE_URL=http://127.0.0.1:3020/api/intake/website
# OPS_INTAKE_SECRET=
